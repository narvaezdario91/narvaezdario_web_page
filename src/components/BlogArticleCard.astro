---
interface Props {
  title: string;
  excerpt: string;
  date: Date;
  tags: string[];
  slug: string;
}

const { title, excerpt, date, tags, slug } = Astro.props;

// Format the date using Intl.DateTimeFormat
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<article
  class="group relative flex h-full flex-col rounded-lg border border-border-hairline bg-surface-raised p-6 transition-transform duration-200 focus-within:ring-2 focus-within:ring-accent hover:border-accent active:scale-[0.98]"
>
  <div class="mb-4">
    <h3
      class="mb-2 font-sans text-xl font-semibold text-text-ink transition-colors duration-200 group-hover:text-accent"
    >
      <a
        href={`${baseUrl}/blog/${slug}`}
        class="outline-none before:absolute before:inset-0 before:z-0"
      >
        {title}
      </a>
    </h3>
    <time datetime={date.toISOString()} class="font-mono text-sm text-text-ink opacity-70">
      {formattedDate}
    </time>
  </div>

  <p class="relative z-10 mb-6 line-clamp-3 flex-grow font-sans text-text-ink opacity-80">
    {excerpt}
  </p>

  <div class="relative z-10 mt-auto flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <a
          href={`${baseUrl}/blog/tag/${encodeURIComponent(tag)}`}
          class="rounded border border-border-hairline bg-surface-base px-2 py-1 font-mono text-xs text-text-ink opacity-90 outline-none transition-all hover:border-accent hover:opacity-100 focus-visible:ring-2 focus-visible:ring-accent active:scale-95"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</article>
