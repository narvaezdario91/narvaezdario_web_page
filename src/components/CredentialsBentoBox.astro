---

<div class="grid w-full grid-cols-1 gap-4 md:grid-cols-4">
  <!-- Education Card (2x2) -->
  <div
    class="flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--surface-raised)] p-6 transition-colors duration-200 hover:border-[var(--accent)] md:col-span-2 md:row-span-2"
  >
    <div>
      <h3 class="mb-4 text-xl font-bold tracking-tight text-[var(--text-ink)]">
        Formación Académica
      </h3>
      <div class="space-y-4">
        {
          education.map((ed) => (
            <div class="border-l-2 border-[var(--accent)] pl-4">
              <h4 class="text-sm font-bold text-[var(--text-ink)]">{ed.degree}</h4>
              <p class="mt-1 font-mono text-xs text-[var(--text-ink)] opacity-70">
                {ed.institution} • {ed.year}
              </p>
              {ed.highlight && <p class="mt-1 text-xs text-[var(--accent)]">{ed.highlight}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Continuous Education Card (2x2) -->
  <div
    class="flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--surface-raised)] p-6 transition-colors duration-200 hover:border-[var(--accent)] md:col-span-2 md:row-span-2"
  >
    <div>
      <h3 class="mb-4 text-xl font-bold tracking-tight text-[var(--text-ink)]">
        Educación Continua & Publicaciones
      </h3>
      <div class="space-y-4">
        {
          continuousEducation.map((ed) => (
            <div class="border-l-2 border-[var(--accent)] pl-4">
              <h4 class="text-sm font-bold text-[var(--text-ink)]">{ed.title}</h4>
              <p class="mt-1 font-mono text-xs text-[var(--text-ink)] opacity-70">
                {ed.institution} • {ed.year}
              </p>
              {ed.highlight && <p class="mt-1 text-xs text-[var(--accent)]">{ed.highlight}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Certification Cards (1x1) -->
  {
    certifications.map((cert) => (
      <div class="group flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--surface-raised)] p-5 transition-colors duration-200 hover:border-[var(--accent)]">
        <div class="mb-2 flex items-start justify-between">
          <span
            class="transition-transform duration-200 group-hover:scale-110"
            set:html={cert.icon}
          />
          <span class="font-mono text-xs text-[var(--text-ink)] opacity-50">{cert.year}</span>
        </div>
        <div>
          <h4 class="mb-1 text-sm font-bold leading-tight text-[var(--text-ink)]">{cert.title}</h4>
          <p class="text-xs text-[var(--text-ink)] opacity-70">{cert.level}</p>
        </div>
      </div>
    ))
  }
</div>
