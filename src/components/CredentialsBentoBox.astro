---

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 w-full">
  <!-- Education Card (2x2) -->
  <div class="md:col-span-2 md:row-span-2 bg-[var(--surface-raised)] border border-[var(--border-hairline)] rounded-xl p-6 flex flex-col justify-between hover:border-[var(--accent)] transition-colors duration-200">
    <div>
      <h3 class="text-xl font-bold text-[var(--text-ink)] mb-4 tracking-tight">Formación Académica</h3>
      <div class="space-y-4">
        {education.map((ed, i) => (
          <div key={`edu-${i}`} class="border-l-2 border-[var(--accent)] pl-4">
            <h4 class="font-bold text-[var(--text-ink)] text-sm">{ed.degree}</h4>
            <p class="text-xs text-[var(--text-ink)] opacity-70 font-mono mt-1">{ed.institution} • {ed.year}</p>
            {ed.highlight && <p class="text-xs text-[var(--accent)] mt-1">{ed.highlight}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Continuous Education Card (2x2) -->
  <div class="md:col-span-2 md:row-span-2 bg-[var(--surface-raised)] border border-[var(--border-hairline)] rounded-xl p-6 flex flex-col justify-between hover:border-[var(--accent)] transition-colors duration-200">
    <div>
      <h3 class="text-xl font-bold text-[var(--text-ink)] mb-4 tracking-tight">Educación Continua & Publicaciones</h3>
      <div class="space-y-4">
        {continuousEducation.map((ed, i) => (
          <div key={`cedu-${i}`} class="border-l-2 border-[var(--accent)] pl-4">
            <h4 class="font-bold text-[var(--text-ink)] text-sm">{ed.title}</h4>
            <p class="text-xs text-[var(--text-ink)] opacity-70 font-mono mt-1">{ed.institution} • {ed.year}</p>
            {ed.highlight && <p class="text-xs text-[var(--accent)] mt-1">{ed.highlight}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Certification Cards (1x1) -->
  {certifications.map((cert, i) => (
    <div key={`cert-${i}`} class="bg-[var(--surface-raised)] border border-[var(--border-hairline)] rounded-xl p-5 flex flex-col justify-between hover:border-[var(--accent)] transition-colors duration-200 group">
      <div class="flex justify-between items-start mb-2">
        <span class="group-hover:scale-110 transition-transform duration-200" set:html={cert.icon}></span>
        <span class="text-xs font-mono text-[var(--text-ink)] opacity-50">{cert.year}</span>
      </div>
      <div>
        <h4 class="font-bold text-[var(--text-ink)] text-sm leading-tight mb-1">{cert.title}</h4>
        <p class="text-xs text-[var(--text-ink)] opacity-70">{cert.level}</p>
      </div>
    </div>
  ))}
</div>
