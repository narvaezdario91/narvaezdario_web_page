---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout title={`${post.data.title} | Blog Darío Narváez`}>
  <main class="container mx-auto px-4 py-16">
    <article class="mx-auto max-w-3xl">
      <header class="mb-10">
        <a
          href={`${baseUrl}/blog`}
          class="mb-6 inline-block font-medium text-accent hover:underline"
        >
          &larr; Volver al blog
        </a>
        <h1 class="mb-6 text-4xl font-bold leading-tight text-text-ink md:text-5xl">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-text-ink opacity-80">
          <time datetime={post.data.date.toISOString()} class="font-medium">
            {formatDate(post.data.date)}
          </time>
          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-md border border-border-hairline bg-surface-raised px-2.5 py-1 text-sm text-text-ink">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      {/* Markdown Content with Tailwind Typography */}
      <div
        class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-text-ink prose-p:leading-relaxed prose-p:text-text-ink prose-a:text-accent prose-a:no-underline hover:prose-a:opacity-80 prose-blockquote:rounded-r-lg prose-blockquote:border-l-accent prose-blockquote:bg-surface-raised prose-blockquote:px-4 prose-blockquote:py-1 prose-blockquote:not-italic prose-blockquote:text-text-ink prose-strong:text-text-ink prose-code:rounded prose-code:bg-surface-raised prose-code:px-1 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:text-accent prose-code:before:content-none prose-code:after:content-none prose-pre:overflow-x-auto prose-pre:rounded-lg prose-pre:border prose-pre:border-border-hairline prose-pre:bg-[#282a36] prose-pre:p-4 prose-pre:font-mono prose-pre:text-sm prose-pre:text-[#f8f8f2] prose-pre:shadow-sm prose-ol:text-text-ink prose-ul:text-text-ink prose-li:text-text-ink prose-img:rounded-xl prose-img:shadow-md prose-hr:border-border-hairline"
      >
        <Content />
      </div>
    </article>
  </main>
</Layout>
