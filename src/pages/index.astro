---
import Layout from '../layouts/Layout.astro';
import CVAccordion from '../components/CVAccordion';
import ImpactGrid from '../components/ImpactGrid';
import { ExperienceTabs } from '../components/ExperienceTabs';
import TechMarquee from '../components/TechMarquee.astro';
import CredentialsBentoBox from '../components/CredentialsBentoBox.astro';

const avalExperience = [
  {
    id: 'react',
    team: 'Re:Act',
    role: 'AI Engineer',
    description:
      'Construí un motor de análisis de sentimientos basado en IA para procesar comentarios de usuarios, reduciendo el tiempo de análisis de UX de 4 horas a 5 minutos. Establecí la base para automatizar encuestas con proto-personas generadas por IA utilizando LangGraph, LangChain, OpenAI y RAGs. Diseñé e implementé un agente autónomo integrado con Jira mediante Atlassian Rovo para analizar historias de usuario y generar automáticamente casos de prueba utilizando técnicas de caja negra, reduciendo el esfuerzo manual de análisis y estandarizando la preparación de pruebas funcionales.',
  },
  {
    id: 'vivienda-digital',
    team: 'AV Villas / Occidente',
    role: 'QA Senior',
    description:
      'Diseñé una arquitectura de automatización basada en Playwright y TypeScript bajo el enfoque Keyword Driven Testing (KDT), integrada con pipelines de CI/CD para pruebas End-to-End sobre aplicaciones web. La solución permitió que analistas funcionales automatizaran sin código, incrementando la cobertura de 9 a 190 escenarios en 6 meses. (100% de cobertura en flujos Core).',
  },
  {
    id: 'servicios-compartidos',
    team: 'Servicios Compartidos',
    role: 'QA Senior',
    description:
      'Diseñé una arquitectura de automatización para APIs basada en Java, Rest Assured y Serenity BDD, integrada en pipelines de CI/CD mediante Jenkins y Git para habilitar pruebas continuas sobre arquitecturas de microservicios. La solución permitió la autogeneración de pruebas a partir de contratos Swagger y validación estática contra un diccionario canónico, reduciendo el tiempo estimado para alcanzar un 90 % de cobertura de 3 años a 1 año, garantizando la disponibilidad de los servicios expuestos para las entidades del grupo AVAL.',
  },
  {
    id: 'transversal',
    team: 'Transversal',
    role: 'QA Senior',
    description:
      'Apoyé en el liderazgo de la definición y adopción del estándar corporativo para pruebas de rendimiento, diseñando una arquitectura reutilizable basada en K6 y Docker para la ejecución consistente de pruebas de carga y estrés.',
  },
];

const experienceData = [
  {
    id: 'thales',
    roleTitle: 'Ingeniero Validador',
    company: 'THALES (Antes Gemalto)',
    period: '06/2019 – 06/2021',
    description:
      'Responsable de la evaluación y calidad de soluciones mediante pruebas manuales y automatizadas para sistemas críticos gubernamentales.',
    achievements: [
      '**Automatización de Sistemas Biométricos (Nuevo León, México):** Lideré la automatización end-to-end del enrolamiento ciudadano (ABIS).',
      '**Continuidad Operativa (Ministerio del Interior, Paraguay):** Diseñé una solución de automatización que sustituyó la dependencia de dispositivos biométricos físicos mediante mecanismos de simulación.',
    ],
    defaultOpen: false,
  },
  {
    id: 'seratic',
    roleTitle: 'Desarrollador de Software',
    company: 'SERATIC',
    period: '04/2017 – 03/2019',
    achievements: [
      '**Desarrollo de Middleware e Integraciones:** Diseñé y codifiqué sistemas intermedios (Groovy / Grails).',
      '**Arquitectura y Rendimiento:** Construí y ejecuté pruebas automatizadas de carga (jMeter y SOAP UI).',
      '**Gestión de Producto Internacional:** Actué como Product Owner asignado en Perú (ENEL, MAPFRE, Telefónica, SOLGAS).',
    ],
    defaultOpen: false,
  },
  {
    id: 'agilcon',
    roleTitle: 'Desarrollador de Software',
    company: 'AGILCON S.A.S.',
    period: '03/2014 – 03/2017',
    achievements: [
      '**Liderazgo Ágil y Desarrollo Fullstack:** Scrum Master y desarrollador web/móvil (Bancolombia, Alpopular, Ripley).',
      '**Modernización de Arquitecturas:** Lideré migración tecnológica legacy (Oracle Forms) a arquitecturas modernas (Groovy/Grails).',
    ],
    defaultOpen: false,
  },
];
---

<Layout title="Darío Narváez | QA Automation Senior & AI Engineer">
  <main class="main-content">
    <section class="hero-section">
      <h1 class="hero-title">Darío Narváez</h1>
      <p class="hero-subtitle">QA Automation Senior | AI Engineer | Software Architecture</p>
    </section>

    <section class="impact-section" aria-labelledby="impact-heading">
      <h2 id="impact-heading" class="section-title">Impacto Cuantitativo & Métricas Clave</h2>
      <ImpactGrid client:visible />
    </section>

    <section class="experience-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-title">Experiencia Laboral</h2>
      <div class="mb-8">
        <ExperienceTabs client:visible data={avalExperience} />
      </div>
      <div class="accordion-list">
        {
          experienceData.map((item) => (
            <CVAccordion
              client:visible
              id={item.id}
              roleTitle={item.roleTitle}
              company={item.company}
              period={item.period}
              description={item.description}
              achievements={item.achievements}
              defaultOpen={item.defaultOpen}
            />
          ))
        }
      </div>
    </section>

    <section class="credentials-section" aria-labelledby="credentials-heading">
      <h2 id="credentials-heading" class="section-title">Stack Tecnológico y Credenciales</h2>
      <TechMarquee />
      <div class="mt-8">
        <CredentialsBentoBox />
      </div>
    </section>
  </main>
</Layout>

<style>
  .main-content {
    padding: var(--space-8) 0 var(--space-8) 0;
  }

  .hero-section {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw + 1rem, 4rem);
    font-weight: 800;
    color: var(--text-ink);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw + 0.5rem, 1.35rem);
    color: var(--accent);
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.01em;
    opacity: 0.9;
  }

  .impact-section {
    margin-top: 3rem;
    margin-bottom: 4rem;
  }

  .experience-section {
    margin-top: 0;
    margin-bottom: 4rem;
  }

  .credentials-section {
    margin-top: 0;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw + 1rem, 2.25rem);
    font-weight: 700;
    color: var(--text-ink);
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border-hairline);
    padding-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
